# Copy to `.env` (gitignored) and set every value. Nothing here is a default to keep.

# The TessariDB owner the database declares on first start. Only the one-shot
# `s3-account` step signs in as it, to declare the S3 server's own account.
TESSARIDB_USER=owner
TESSARIDB_PASSWORD=

# The S3 server's own database account (user `s3`, an editor of `s3.meta` only):
# at least 16 characters, no quote or backslash.
S3_META_PASSWORD=

# The S3 root credential: an access key (no "/") and a secret of at least 16 bytes.
S3_ROOT_ACCESS_KEY=
S3_ROOT_SECRET_KEY=

# 64 hexadecimal digits (`openssl rand -hex 32`); without it no user access key can be issued.
S3_IAM_KEY=

# Optional.
# S3_REGION=us-east-1
# S3_PORT=9100
# S3_CONSOLE_PORT=9101
